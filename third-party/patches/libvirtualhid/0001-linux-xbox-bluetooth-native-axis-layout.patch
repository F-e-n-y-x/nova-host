+  LinuxXboxBluetoothWire linux_xbox_bluetooth_uhid_wire(GamepadProfileKind kind, const GamepadState &state) {
+    LinuxXboxBluetoothWire wire;
+    std::array<int, 2> descriptors {-1, -1};
+    if (::socketpair(AF_UNIX, SOCK_STREAM, 0, descriptors.data()) != 0) {
+      wire.status = system_error_status(ErrorCode::backend_failure, "failed to create socketpair", errno);
+      return wire;
+    }
+
+    const auto profile = profiles::gamepad_profile(kind).value();
+    CreateGamepadOptions options;
+    options.profile = profile;
+    options.metadata.stable_id = "xbox-bluetooth-uhid-wire";
+
+    LinuxUhidRoundTripResult lifecycle;
+    UhidGamepad gamepad {descriptors[0]};
+    auto event = create_started_profile_uhid_gamepad(gamepad, 17, options, descriptors[1], BUS_BLUETOOTH, lifecycle);
+    if (!lifecycle.creation.saw_create) {
+      wire.status = lifecycle.create_status.ok() ?
+                      OperationStatus::failure(ErrorCode::backend_failure, "UHID create event was not observed") :
+                      lifecycle.create_status;
+      static_cast<void>(gamepad.close());
+      static_cast<void>(::close(descriptors[1]));
+      return wire;
+    }
+    wire.descriptor.assign(event.u.create2.rd_data, event.u.create2.rd_data + event.u.create2.rd_size);
+
+    event = {};
+    event.type = UHID_OPEN;
+    static_cast<void>(write_uhid_event(descriptors[1], event));
+
+    const auto report = reports::pack_input_report(profile, state);
+    wire.status = gamepad.submit(state, report);
+    if (wire.status.ok() && read_uhid_event_type(descriptors[1], UHID_INPUT2, event)) {
+      wire.input_report.assign(event.u.input2.data, event.u.input2.data + event.u.input2.size);
+    }
+
+    static_cast<void>(gamepad.close());
+    static_cast<void>(::close(descriptors[1]));
+    return wire;
+  }
