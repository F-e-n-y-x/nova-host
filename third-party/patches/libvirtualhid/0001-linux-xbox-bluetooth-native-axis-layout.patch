+    struct EvdevGamepadAxisCodes {
+      std::uint16_t right_x;  ///< Right stick horizontal axis.
+      std::uint16_t right_y;  ///< Right stick vertical axis.
+      std::uint16_t left_trigger;  ///< Left analog trigger.
+      std::uint16_t right_trigger;  ///< Right analog trigger.
+    };
