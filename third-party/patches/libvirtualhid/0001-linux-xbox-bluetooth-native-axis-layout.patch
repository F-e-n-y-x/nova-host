+    /**
+     * @brief Choose the evdev axis codes a gamepad profile exposes.
+     *
+     * The Xbox One and Series profiles identify as the Bluetooth controllers (045e:0b20 and
+     * 045e:0b13), so their axes must match what the Linux kernel reports for that hardware: right
+     * stick on ABS_Z/ABS_RZ, left trigger on ABS_BRAKE and right trigger on ABS_GAS. Chromium's
+     * standard gamepad mapping and SDL's controller database select their layout from the vendor
+     * and product IDs, so the xpad-style ABS_RX/ABS_RY + ABS_Z/ABS_RZ layout shifts the axes there
+     * (the right trigger reads as the left one and the right stick drives the triggers).
+     *
+     * @param kind Gamepad profile kind.
+     * @return Evdev axis codes for the profile.
+     */
+    constexpr EvdevGamepadAxisCodes evdev_gamepad_axis_codes(GamepadProfileKind kind) {
+      if (kind == GamepadProfileKind::xbox_one || kind == GamepadProfileKind::xbox_series) {
+        return {.right_x = ABS_Z, .right_y = ABS_RZ, .left_trigger = ABS_BRAKE, .right_trigger = ABS_GAS};
+      }
+      return {.right_x = ABS_RX, .right_y = ABS_RY, .left_trigger = ABS_Z, .right_trigger = ABS_RZ};
+    }
