+namespace {
+  /**
+   * @brief One absolute axis the Linux kernel would create from a HID input field.
+   */
+  struct KernelAbsField {
+    std::uint16_t code;  ///< Evdev ABS code the kernel's hid-input maps the usage to.
+    std::size_t bit_offset;  ///< Bit offset in the report payload, after the report ID.
+    std::size_t bit_size;  ///< Field width in bits.
+    std::int64_t logical_minimum;  ///< HID logical minimum.
+    std::int64_t logical_maximum;  ///< HID logical maximum.
+  };
+
+  /**
+   * @brief Map a HID usage to an evdev ABS code the way Linux hid-input does for gamepads.
+   *
+   * Only the usages an Xbox Bluetooth descriptor can carry are handled; the hat switch is left
+   * out because the kernel turns it into ABS_HAT0X/ABS_HAT0Y, which joydev appends after these.
+   */
+  std::optional<std::uint16_t> kernel_abs_code(std::uint32_t usage_page, std::uint32_t usage) {
+    if (usage_page == 0x01U && usage >= 0x30U && usage <= 0x35U) {
+      return static_cast<std::uint16_t>(ABS_X + (usage - 0x30U));  // X, Y, Z, Rx, Ry, Rz
+    }
+    if (usage_page == 0x02U && usage == 0xC4U) {
+      return static_cast<std::uint16_t>(ABS_GAS);  // Accelerator
+    }
+    if (usage_page == 0x02U && usage == 0xC5U) {
+      return static_cast<std::uint16_t>(ABS_BRAKE);  // Brake
+    }
+    return std::nullopt;
+  }
+
+  /**
+   * @brief Parse the input fields of one report ID into kernel ABS axes, sorted by ABS code.
+   *
+   * The sort mirrors joydev and Chromium on Linux, which number axes in ABS-code order.
+   */
+  std::vector<KernelAbsField> kernel_abs_fields(const std::vector<std::uint8_t> &descriptor, std::uint8_t report_id) {
+    std::vector<KernelAbsField> fields;
+    std::uint32_t usage_page = 0;
+    std::int64_t logical_minimum = 0;
+    std::int64_t logical_maximum = 0;
+    std::size_t report_size = 0;
+    std::size_t report_count = 0;
+    std::uint8_t current_report_id = 0;
+    std::vector<std::uint32_t> usages;
+    std::size_t bit_offset = 0;
+
+    for (std::size_t index = 0; index < descriptor.size();) {
+      const auto prefix = descriptor[index];
+      const std::size_t size = (prefix & 0x03U) == 0x03U ? 4U : (prefix & 0x03U);
+      std::uint32_t value = 0;
+      for (std::size_t byte = 0; byte < size && index + 1U + byte < descriptor.size(); ++byte) {
+        value |= static_cast<std::uint32_t>(descriptor[index + 1U + byte]) << (8U * byte);
+      }
+      std::int64_t signed_value = value;
+      if (size == 1U) {
+        signed_value = static_cast<std::int8_t>(value);
+      } else if (size == 2U) {
+        signed_value = static_cast<std::int16_t>(value);
+      } else if (size == 4U) {
+        signed_value = static_cast<std::int32_t>(value);
+      }
+      index += 1U + size;
+
+      switch (prefix & 0xFCU) {
+        case 0x04U:  // Usage Page
+          usage_page = value;
+          break;
+        case 0x14U:  // Logical Minimum
+          logical_minimum = signed_value;
+          break;
+        case 0x24U:  // Logical Maximum (unsigned when the minimum is not negative)
+          logical_maximum = logical_minimum >= 0 ? static_cast<std::int64_t>(value) : signed_value;
+          break;
+        case 0x74U:  // Report Size
+          report_size = value;
+          break;
+        case 0x94U:  // Report Count
+          report_count = value;
+          break;
+        case 0x84U:  // Report ID
+          current_report_id = static_cast<std::uint8_t>(value);
+          bit_offset = 0;
+          break;
+        case 0x08U:  // Usage
+          usages.push_back(value);
+          break;
+        case 0x80U:  // Input
+          if (current_report_id == report_id) {
+            const auto constant = (value & 0x01U) != 0U;
+            for (std::size_t item = 0; item < report_count; ++item) {
+              if (!constant && !usages.empty()) {
+                const auto usage = usages[std::min(item, usages.size() - 1U)];
+                if (const auto code = kernel_abs_code(usage_page, usage); code.has_value()) {
+                  fields.push_back({*code, bit_offset, report_size, logical_minimum, logical_maximum});
+                }
+              }
+              bit_offset += report_size;
+            }
+          }
+          usages.clear();
+          break;
+        case 0x90U:  // Output
+        case 0xB0U:  // Feature
+        case 0xA0U:  // Collection
+        case 0xC0U:  // End Collection
+          usages.clear();
+          break;
+        default:
+          break;
+      }
+    }
+
+    std::ranges::sort(fields, {}, &KernelAbsField::code);
+    return fields;
+  }
+
+  /**
+   * @brief Read a field from an input report payload and normalize it to [-1, 1] as Chromium does.
+   */
+  double normalized_field(const std::vector<std::uint8_t> &report, const KernelAbsField &field) {
+    std::uint64_t raw = 0;
+    for (std::size_t bit = 0; bit < field.bit_size; ++bit) {
+      const auto absolute_bit = field.bit_offset + bit;
+      const auto byte = 1U + (absolute_bit / 8U);  // Skip the report ID.
+      if (byte < report.size() && (report[byte] >> (absolute_bit % 8U)) & 0x01U) {
+        raw |= std::uint64_t {1} << bit;
+      }
+    }
+    const auto range = static_cast<double>(field.logical_maximum - field.logical_minimum);
+    return (2.0 * (static_cast<double>(raw) - static_cast<double>(field.logical_minimum)) / range) - 1.0;
+  }
+
+  /**
+   * @brief Standard Gamepad values a browser shows for one Xbox Bluetooth report.
+   */
+  struct StandardGamepadAxes {
+    double left_x;  ///< Standard axis 0.
+    double left_y;  ///< Standard axis 1 (up is negative).
+    double right_x;  ///< Standard axis 2.
+    double right_y;  ///< Standard axis 3 (up is negative).
+    double left_trigger;  ///< Standard button 6 value.
+    double right_trigger;  ///< Standard button 7 value.
+  };
+
+  /**
+   * @brief Apply Chromium's Linux MapperXboxBluetooth, used for 045e:0b13, 045e:0b20 and 045e:0b22.
+   *
+   * See device/gamepad/gamepad_standard_mappings_linux.cc: axes 0-3 pass through as the two
+   * sticks, the left trigger is axis 5 and the right trigger is axis 4.
+   */
+  StandardGamepadAxes chromium_xbox_bluetooth_mapping(const std::vector<double> &axes) {
+    const auto axis = [&axes](std::size_t index) {
+      return index < axes.size() ? axes[index] : 0.0;
+    };
+    return {
+      .left_x = axis(0),
+      .left_y = axis(1),
+      .right_x = axis(2),
+      .right_y = axis(3),
+      .left_trigger = (axis(5) + 1.0) / 2.0,
+      .right_trigger = (axis(4) + 1.0) / 2.0,
+    };
+  }
+}  // namespace
+
+TEST_F(LinuxBackendTest, XboxBluetoothUhidDescriptorUsesNativeKernelAxisLayout) {
+  using enum lvh::GamepadProfileKind;
+
+  for (const auto kind : {xbox_one, xbox_series}) {
+    const auto wire = lvh::detail::test::linux_xbox_bluetooth_uhid_wire(kind, {});
+    ASSERT_TRUE(wire.status.ok()) << wire.status.message();
+    const auto fields = kernel_abs_fields(wire.descriptor, 0x01U);
+
+    std::vector<std::uint16_t> codes;
+    for (const auto &field : fields) {
+      codes.push_back(field.code);
+    }
+    // The kernel's axes for a real Xbox Bluetooth controller.
+    const std::vector<std::uint16_t> expected {ABS_X, ABS_Y, ABS_Z, ABS_RZ, ABS_GAS, ABS_BRAKE};
+    EXPECT_EQ(codes, expected) << "profile " << static_cast<int>(std::to_underlying(kind));
+  }
+}
