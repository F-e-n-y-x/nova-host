+TEST_F(LinuxBackendTest, XboxBluetoothUhidMovesOnlyTheMatchingStandardGamepadAxis) {
+  using enum lvh::GamepadProfileKind;
+
+  /**
+   * @brief One logical input set on its own, and the standard axis it must move.
+   */
+  struct AxisCase {
+    std::string_view name;  ///< Logical input.
+    lvh::GamepadState state;  ///< State with only that input moved.
+    StandardGamepadAxes expected;  ///< Browser view of that state.
+  };
+
+  constexpr StandardGamepadAxes neutral {};
+  const auto with = [](auto mutate) {
+    lvh::GamepadState state;
+    mutate(state);
+    return state;
+  };
+  const auto expect = [neutral](auto mutate) {
+    auto axes = neutral;
+    mutate(axes);
+    return axes;
+  };
+  const std::array cases {
+    AxisCase {"left stick right", with([](auto &s) { s.left_stick.x = 1.0F; }), expect([](auto &a) { a.left_x = 1.0; })},
+    AxisCase {"left stick left", with([](auto &s) { s.left_stick.x = -1.0F; }), expect([](auto &a) { a.left_x = -1.0; })},
+    AxisCase {"left stick up", with([](auto &s) { s.left_stick.y = 1.0F; }), expect([](auto &a) { a.left_y = -1.0; })},
+    AxisCase {"right stick right", with([](auto &s) { s.right_stick.x = 1.0F; }), expect([](auto &a) { a.right_x = 1.0; })},
+    AxisCase {"right stick left", with([](auto &s) { s.right_stick.x = -1.0F; }), expect([](auto &a) { a.right_x = -1.0; })},
+    AxisCase {"right stick up", with([](auto &s) { s.right_stick.y = 1.0F; }), expect([](auto &a) { a.right_y = -1.0; })},
+    AxisCase {"right stick down", with([](auto &s) { s.right_stick.y = -1.0F; }), expect([](auto &a) { a.right_y = 1.0; })},
+    AxisCase {"left trigger", with([](auto &s) { s.left_trigger = 1.0F; }), expect([](auto &a) { a.left_trigger = 1.0; })},
+    AxisCase {"right trigger", with([](auto &s) { s.right_trigger = 1.0F; }), expect([](auto &a) { a.right_trigger = 1.0; })},
+    AxisCase {"neutral", lvh::GamepadState {}, neutral},
+  };
+
+  constexpr double tolerance = 0.01;
+  for (const auto kind : {xbox_one, xbox_series}) {
+    for (const auto &[name, state, expected] : cases) {
+      const auto wire = lvh::detail::test::linux_xbox_bluetooth_uhid_wire(kind, state);
+      ASSERT_TRUE(wire.status.ok()) << wire.status.message();
+      ASSERT_FALSE(wire.input_report.empty()) << name;
+      std::vector<double> axes;
+      for (const auto &field : kernel_abs_fields(wire.descriptor, wire.input_report.front())) {
+        axes.push_back(normalized_field(wire.input_report, field));
+      }
+      const auto actual = chromium_xbox_bluetooth_mapping(axes);
+      const auto context = std::format("profile {} input '{}'", static_cast<int>(std::to_underlying(kind)), name);
+      EXPECT_NEAR(actual.left_x, expected.left_x, tolerance) << context << ": standard left stick X";
+      EXPECT_NEAR(actual.left_y, expected.left_y, tolerance) << context << ": standard left stick Y";
+      EXPECT_NEAR(actual.right_x, expected.right_x, tolerance) << context << ": standard right stick X";
+      EXPECT_NEAR(actual.right_y, expected.right_y, tolerance) << context << ": standard right stick Y";
+      EXPECT_NEAR(actual.left_trigger, expected.left_trigger, tolerance) << context << ": standard LT";
+      EXPECT_NEAR(actual.right_trigger, expected.right_trigger, tolerance) << context << ": standard RT";
+    }
+  }
+}
