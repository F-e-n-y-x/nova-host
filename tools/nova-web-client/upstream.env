# Pinned upstream for the Nova browser client sidecar.
# moonlight-web-stream is GPL-3.0-or-later; it is fetched at build time, patched with
# patches/*.patch and run as a separate process (never linked into Nova).
MWS_REPO=https://github.com/MrCreativ3001/moonlight-web-stream.git
MWS_TAG=v2.10.0
MWS_COMMIT=cd9d03cbf9a42b394f7b72a733a2f39cb5f0edd8
# Must match MWS's rust-toolchain.toml at MWS_COMMIT.
MWS_RUST_TOOLCHAIN=nightly-2026-02-13
# Geist Sans for Nova's interface on the browser client pages (SIL OFL 1.1), from npm.
GEIST_SANS_VERSION=5.3.0
GEIST_SANS_SHA256=83a1aea1e31d9427fe58c42574e1d76c1563c42ee44c054797fbef8243c0ba50
