#!/usr/bin/env python3
"""The desktop Nova runs on a Virtual display (virtual_display_session = desktop).

Nova starts this on the headless X server (DISPLAY=:N) instead of a bare window manager, so a
"Desktop (Virtual display)" stream shows a usable desktop and a game launched there has one behind it:

- the user's Cinnamon wallpaper (org.cinnamon.desktop.background), else Nova's default
- desktop icons (nemo-desktop), a tint2 panel with a launcher, task list and clock
- Openbox with a right-click menu: terminal, files, browser, Lutris and the Nova Library games

The session is kept away from the desktop on :0:
- It gets its own D-Bus session bus (dbus-run-session). nemo-desktop, nemo and gnome-terminal are
  single-instance D-Bus apps: on the shared bus a second nemo-desktop exits at once and a terminal
  opened here would appear on :0.
- nemo-desktop runs with a private XDG_CONFIG_HOME holding a copy of the user's dconf database and
  GTK settings, so anything it writes stays in that copy.
- GIO_USE_VFS=local and no portals, so no second gvfs/metadata daemon writes the user's files.
- Chrome gets its own profile directory; with the normal profile Chrome hands the window to the
  instance already running on :0.

Subcommands (Nova runs them with DISPLAY, XAUTHORITY and NOVA_VD_DIR set):
  (none) | start   run the session (blocks; Nova stops it by signalling the process group)
  refresh          the screen was resized: redraw the wallpaper at the new size
  scale PERCENT    set the display scale (100, 125, 150, 175 or 200) and reload the panel and icons
  menu             print the Openbox pipe menu of Nova Library games
  run CMD...       run a program with the session's scale variables (used by the menu and panel)

Environment:
  NOVA_VD_DIR        per-display state directory (required, created 0700 by Nova)
  NOVA_VD_WM         window manager (default "openbox")
  NOVA_VD_SCALE      initial scale in percent (default 100)
  NOVA_VD_APPS       Nova's apps.json, for the Library menu
  NOVA_VD_WALLPAPER  default wallpaper when the user has none
"""
import json
import os
import shlex
import shutil
import signal
import subprocess
import sys
import time
import urllib.parse
from xml.sax.saxutils import escape, quoteattr

SCALES = (100, 125, 150, 175, 200)
SELF = os.path.abspath(__file__)


def log(*parts):
    print("nova-vd-session:", *parts, file=sys.stderr, flush=True)


def state_dir():
    d = os.environ.get("NOVA_VD_DIR", "")
    if not d:
        log("NOVA_VD_DIR is not set")
        sys.exit(2)
    return os.path.join(d, "session")


def home():
    return os.environ.get("HOME") or os.path.expanduser("~")


def user_config_home():
    return os.environ.get("NOVA_VD_USER_CONFIG") or os.environ.get("XDG_CONFIG_HOME") or os.path.join(home(), ".config")


def clamp_scale(value):
    try:
        pct = int(str(value).strip().rstrip("%"))
    except ValueError:
        return 100
    return min(SCALES, key=lambda s: abs(s - pct))


def read_scale(d):
    try:
        with open(os.path.join(d, "scale"), encoding="utf-8") as f:
            return clamp_scale(f.read())
    except OSError:
        return clamp_scale(os.environ.get("NOVA_VD_SCALE", "100"))


def scale_env(pct):
    """Variables for programs started at a scale: GTK takes an integer GDK_SCALE plus a font factor."""
    factor = pct / 100
    gdk_scale = 2 if pct >= 200 else 1
    return {
        "GDK_SCALE": str(gdk_scale),
        "GDK_DPI_SCALE": f"{factor / gdk_scale:g}",
        "QT_SCALE_FACTOR": f"{factor:g}",
        "QT_AUTO_SCREEN_SCALE_FACTOR": "0",
        "ELM_SCALE": f"{factor:g}",
    }


def run_quiet(argv, env=None, timeout=10):
    try:
        return subprocess.run(argv, env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=timeout).returncode
    except (OSError, subprocess.SubprocessError):
        return -1


def screen_size():
    try:
        out = subprocess.run(["xrandr", "--current"], capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    for line in out.splitlines():
        if line.startswith("Screen ") and " current " in line:
            cur = line.split(" current ", 1)[1].split(",", 1)[0]
            w, h = cur.replace(" ", "").split("x")
            return int(w), int(h)
    return None


def gsetting(schema, key):
    """Read the user's setting straight from their dconf database (no bus needed)."""
    env = dict(os.environ)
    env.pop("DCONF_PROFILE", None)
    env["XDG_CONFIG_HOME"] = user_config_home()
    try:
        out = subprocess.run(["gsettings", "get", schema, key], capture_output=True, text=True, env=env, timeout=5)
    except (OSError, subprocess.SubprocessError):
        return ""
    value = out.stdout.strip()
    if len(value) >= 2 and value[0] == value[-1] and value[0] in "'\"":
        value = value[1:-1]
    return value if out.returncode == 0 else ""


def wallpaper_source():
    uri = gsetting("org.cinnamon.desktop.background", "picture-uri")
    if uri.startswith("file://"):
        path = urllib.parse.unquote(urllib.parse.urlparse(uri).path)
        if os.path.isfile(path):
            return os.path.realpath(path), gsetting("org.cinnamon.desktop.background", "picture-options") or "zoom"
    default = os.environ.get("NOVA_VD_WALLPAPER", "")
    if default and os.path.isfile(default):
        return default, "zoom"
    return "", ""


def geometry_args(options, w, h):
    size = f"{w}x{h}"
    if options == "stretched":
        return ["-resize", size + "!"]
    if options in ("scaled", "centered"):
        fit = ["-resize", size] if options == "scaled" else []
        return fit + ["-background", "black", "-gravity", "center", "-extent", size]
    return ["-resize", size + "^", "-gravity", "center", "-extent", size]  # zoom, spanned, wallpaper


def draw_wallpaper(d):
    """Paint the root window (what shows without desktop icons) and keep a copy for the icon view."""
    src, options = wallpaper_source()
    size = screen_size()
    if not src or not size or not shutil.which("convert"):
        run_quiet(["xsetroot", "-solid", "#141824"])
        return ""
    out = os.path.join(d, "wallpaper.png")
    tmp = out + ".tmp.png"
    if run_quiet(["convert", src + "[0]", *geometry_args(options, *size), "-depth", "8", tmp], timeout=30) != 0:
        run_quiet(["xsetroot", "-solid", "#141824"])
        return ""
    os.replace(tmp, out)
    if shutil.which("display"):
        run_quiet(["display", "-window", "root", out], timeout=15)
    return out


DCONF_DB = "nova_virtual_display"  # a D-Bus object path element: letters, digits, _ only


def isolate_dconf(d):
    """Give the session its own copy of the user's dconf database (~/.config/dconf/nova_virtual_display).

    Readers see the user's settings; writes (a second dconf-service runs on the private bus) land in
    the copy, so they can never race the desktop's dconf-service over ~/.config/dconf/user.
    """
    dconf_dir = os.path.join(user_config_home(), "dconf")
    src_db = os.path.join(dconf_dir, "user")
    if os.path.isfile(src_db):
        os.makedirs(dconf_dir, exist_ok=True)
        shutil.copyfile(src_db, os.path.join(dconf_dir, DCONF_DB))
    profile = os.path.join(d, "dconf-profile")
    with open(profile, "w", encoding="utf-8") as f:
        f.write(f"user-db:{DCONF_DB}\n")
    return profile


def write_nemo_config(d, wallpaper, pct):
    """A private config home for nemo-desktop: the user's dconf and GTK settings, plus the wallpaper.

    Without a compositor nemo-desktop paints its transparent desktop window black; this CSS gives
    that window the wallpaper instead.
    """
    cfg = os.path.join(d, "nemo-config")
    os.makedirs(os.path.join(cfg, "gtk-3.0"), exist_ok=True)
    # dconf-service resolves the database under its own config home, so share the real directory
    # (the session reads and writes only its nova_virtual_display copy there).
    link = os.path.join(cfg, "dconf")
    if not os.path.islink(link):
        shutil.rmtree(link, ignore_errors=True)
        os.symlink(os.path.join(user_config_home(), "dconf"), link)
    for name in ("settings.ini", "bookmarks"):
        src = os.path.join(user_config_home(), "gtk-3.0", name)
        if os.path.isfile(src):
            shutil.copyfile(src, os.path.join(cfg, "gtk-3.0", name))
    user_css = os.path.join(user_config_home(), "gtk-3.0", "gtk.css")
    css = []
    if os.path.isfile(user_css):
        css.append(f'@import url("file://{urllib.parse.quote(user_css)}");')
    if wallpaper:
        css.append(
            ".nemo-desktop-window, .nemo-desktop.view, .nemo-desktop-icon-view {\n"
            f'  background-image: url("file://{urllib.parse.quote(wallpaper)}?{int(time.time())}");\n'
            "  background-size: cover;\n  background-position: center;\n}"
        )
    with open(os.path.join(cfg, "gtk-3.0", "gtk.css"), "w", encoding="utf-8") as f:
        f.write("\n".join(css) + "\n")
    return cfg


def nemo_env(cfg):
    """nemo-desktop's icon grid doesn't grow with larger text, so its labels would overlap at
    125-175 %: it keeps normal text and only takes the integer GDK_SCALE (200 %)."""
    return {"XDG_CONFIG_HOME": cfg, "GDK_DPI_SCALE": "1"}


def browser_command():
    for name in ("google-chrome-stable", "google-chrome", "chromium", "chromium-browser"):
        if shutil.which(name):
            profile = os.path.join(user_config_home(), "nova-host", "virtual-display-browser")
            return [name, f"--user-data-dir={profile}", "--no-first-run"]
    for name in ("firefox-esr", "firefox"):
        if shutil.which(name):
            return [name, "--new-instance", "-P", "nova-virtual-display"]
    return []


def launchers():
    """(label, icon, argv) for the panel and menu; only programs that are installed."""
    items = []
    if shutil.which("gnome-terminal"):
        items.append(("Terminal", "org.gnome.Terminal", ["gnome-terminal"]))
    elif shutil.which("x-terminal-emulator"):
        items.append(("Terminal", "utilities-terminal", ["x-terminal-emulator"]))
    if shutil.which("nemo"):
        items.append(("Files", "system-file-manager", ["nemo", home()]))
    browser = browser_command()
    if browser:
        icon = "google-chrome" if "chrome" in browser[0] else "web-browser"
        items.append(("Web browser", icon, browser))
    if shutil.which("lutris"):
        items.append(("Lutris", "net.lutris.Lutris", ["lutris"]))
    return items


def write_desktop_files(d):
    apps = os.path.join(d, "applications")
    os.makedirs(apps, exist_ok=True)
    paths = []
    for i, (label, icon, argv) in enumerate(launchers()):
        path = os.path.join(apps, f"nova-vd-{i}.desktop")
        exec_line = " ".join(shlex.quote(a) for a in [SELF, "run", *argv]).replace("%", "%%")
        with open(path, "w", encoding="utf-8") as f:
            f.write(f"[Desktop Entry]\nType=Application\nName={label}\nIcon={icon}\nExec={exec_line}\nTerminal=false\n")
        paths.append(path)
    return paths


