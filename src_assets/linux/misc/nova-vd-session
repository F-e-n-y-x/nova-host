def openbox_theme():
    wanted = gsetting("org.cinnamon.desktop.wm.preferences", "theme")
    for name in (wanted, "Onyx", "Clearlooks"):
        if name and os.path.isdir(os.path.join("/usr/share/themes", name, "openbox-3")):
            return name
    return "Clearlooks"


def write_openbox_config(d, pct):
    """rc.xml (the system one with one desktop, a theme and scaled fonts) and menu.xml."""
    import xml.etree.ElementTree as ET

    ns = "http://openbox.org/3.4/rc"
    ET.register_namespace("", ns)
    q = lambda tag: f"{{{ns}}}{tag}"
    src = next((p for p in ("/etc/xdg/openbox/rc.xml", "/usr/share/openbox/rc.xml") if os.path.isfile(p)), "")
    rc_path = os.path.join(d, "openbox-rc.xml")
    menu_path = os.path.join(d, "openbox-menu.xml")
    if src:
        tree = ET.parse(src)
        root = tree.getroot()
        theme = root.find(q("theme"))
        if theme is not None:
            name = theme.find(q("name"))
            if name is not None:
                name.text = openbox_theme()
            for font in theme.findall(q("font")):
                size = font.find(q("size"))
                if size is not None and (size.text or "").strip().isdigit():
                    size.text = str(max(6, round(int(size.text) * pct / 100)))
        desktops = root.find(q("desktops"))
        if desktops is not None:
            number = desktops.find(q("number"))
            if number is not None:
                number.text = "1"
        menu = root.find(q("menu"))
        if menu is not None:
            for f in menu.findall(q("file")):
                menu.remove(f)
            f = ET.SubElement(menu, q("file"))
            f.text = menu_path
        tree.write(rc_path, encoding="UTF-8", xml_declaration=True)
    else:
        rc_path = ""

    items = []
    for label, _icon, argv in launchers():
        cmd = " ".join(shlex.quote(a) for a in [SELF, "run", *argv])
        items.append(f'  <item label={quoteattr(label)}><action name="Execute"><execute>{escape(cmd)}</execute></action></item>')
    library = " ".join(shlex.quote(a) for a in [SELF, "menu"])
    menu_xml = (
        '<?xml version="1.0" encoding="UTF-8"?>\n<openbox_menu xmlns="http://openbox.org/3.4/menu">\n'
        '<menu id="root-menu" label="Nova">\n' + "\n".join(items) + "\n  <separator />\n"
        f'  <menu id="nova-library" label="Nova Library" execute={quoteattr(library)} />\n'
        "  <separator />\n"
        '  <item label="Reconfigure"><action name="Reconfigure" /></item>\n'
        "</menu>\n</openbox_menu>\n"
    )
    with open(menu_path, "w", encoding="utf-8") as f:
        f.write(menu_xml)
    return rc_path


def library_entries(apps_json):
    """(name, command) for every Nova app with something to run; the Desktop entries have none."""
    try:
        with open(apps_json, encoding="utf-8") as f:
            apps = json.load(f).get("apps", [])
    except (OSError, ValueError, AttributeError):
        return []
    out = []
    for app in apps:
        if not isinstance(app, dict):
            continue
        cmd = app.get("cmd") or ""
        if not cmd:
            detached = app.get("detached") or []
            cmd = detached[0] if isinstance(detached, list) and detached and isinstance(detached[0], str) else ""
        name = str(app.get("name") or "").strip()
        if isinstance(cmd, str) and cmd.strip() and name:
            workdir = app.get("working-dir") or ""
            out.append((name, cmd.strip(), workdir if isinstance(workdir, str) else ""))
    return out


def print_library_menu():
    entries = library_entries(os.environ.get("NOVA_VD_APPS", ""))
    print('<?xml version="1.0" encoding="UTF-8"?>\n<openbox_pipe_menu>')
    if not entries:
        print('  <item label="No games in the Nova Library" />')
    for name, cmd, workdir in entries:
        inner = f"cd {shlex.quote(workdir)} 2>/dev/null; exec {cmd}" if workdir else f"exec {cmd}"
        full = " ".join(shlex.quote(a) for a in [SELF, "run", "/bin/sh", "-c", inner])
        print(f'  <item label={quoteattr(name)}><action name="Execute"><execute>{escape(full)}</execute></action></item>')
    print("</openbox_pipe_menu>")


def apply_dpi(pct):
    dpi = round(96 * pct / 100)
    # A bare `xrandr --dpi` refits the framebuffer to the active outputs, and a headless screen has
    # none, so it would shrink to 8x8: always pass the current size along.
    size = screen_size()
    if size:
        run_quiet(["xrandr", "--fb", f"{size[0]}x{size[1]}", "--dpi", str(dpi)])
    if shutil.which("xrdb"):
        try:
            subprocess.run(["xrdb", "-merge"], input=f"Xft.dpi: {dpi}\n", text=True, timeout=5,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except (OSError, subprocess.SubprocessError):
            pass


class Session:
    def __init__(self, d):
        self.d = d
        self.children = {}
        self.wm = None
        self.pending = set()

    def spawn(self, name, argv, extra=None):
        env = dict(os.environ)
        env.update(scale_env(read_scale(self.d)))
        env.update(extra or {})
        try:
            logf = open(os.path.join(self.d, f"{name}.log"), "ab")
            proc = subprocess.Popen(argv, env=env, stdout=logf, stderr=logf, stdin=subprocess.DEVNULL)
            logf.close()
        except OSError as e:
            log(f"couldn't start {name}: {e}")
            return None
        self.children[name] = proc
        return proc

    def stop_child(self, name):
        proc = self.children.pop(name, None)
        if proc and proc.poll() is None:
            proc.terminate()
            try:
                proc.wait(timeout=3)
            except subprocess.TimeoutExpired:
                proc.kill()

    def start_helpers(self):
        pct = read_scale(self.d)
        apply_dpi(pct)
        wallpaper = draw_wallpaper(self.d)
        if shutil.which("tint2"):
            self.spawn("tint2", ["tint2", "-c", write_tint2rc(self.d, pct)])
        if shutil.which("nemo-desktop"):
            cfg = write_nemo_config(self.d, wallpaper, pct)
            self.spawn("nemo-desktop", ["nemo-desktop"], nemo_env(cfg))

    def reload(self):
        pct = read_scale(self.d)
        log(f"reloading at {pct}%")
        self.stop_child("tint2")
        self.stop_child("nemo-desktop")
        write_openbox_config(self.d, pct)
        if self.wm and self.wm.poll() is None:
            run_quiet(["openbox", "--reconfigure"])
        self.start_helpers()

    def run(self):
        os.makedirs(self.d, mode=0o700, exist_ok=True)
        os.environ["DCONF_PROFILE"] = isolate_dconf(self.d)
        with open(os.path.join(self.d, "pid"), "w", encoding="utf-8") as f:
            f.write(str(os.getpid()))
        if not os.path.exists(os.path.join(self.d, "scale")):
            with open(os.path.join(self.d, "scale"), "w", encoding="utf-8") as f:
                f.write(str(read_scale(self.d)))
        # The bare root window has the "X" cursor; give it the normal arrow.
        run_quiet(["xsetroot", "-cursor_name", "left_ptr"])
        signal.signal(signal.SIGHUP, lambda *_: self.pending.add("reload"))
        signal.signal(signal.SIGUSR1, lambda *_: self.pending.add("refresh"))
        signal.signal(signal.SIGTERM, lambda *_: self.pending.add("quit"))

        wm = os.environ.get("NOVA_VD_WM", "openbox") or "openbox"
        rc = write_openbox_config(self.d, read_scale(self.d)) if os.path.basename(wm.split()[0]) == "openbox" else ""
        argv = shlex.split(wm) + (["--config-file", rc] if rc else [])
        self.wm = self.spawn("wm", argv)
        time.sleep(0.3)
        self.start_helpers()

        restarts = {}
        while True:
            if "quit" in self.pending:
                break
            if "reload" in self.pending:
                self.pending.discard("reload")
                self.pending.discard("refresh")
                self.reload()
            if "refresh" in self.pending:
                self.pending.discard("refresh")
                wallpaper = draw_wallpaper(self.d)
                if "nemo-desktop" in self.children:
                    self.stop_child("nemo-desktop")
                    cfg = write_nemo_config(self.d, wallpaper, read_scale(self.d))
                    self.spawn("nemo-desktop", ["nemo-desktop"], nemo_env(cfg))
            if self.wm is None or self.wm.poll() is not None:
                log("the window manager exited; ending the session")
                break
            # Restart a panel or icon view that crashed, a few times at most.
            for name in ("tint2", "nemo-desktop"):
                proc = self.children.get(name)
                if proc and proc.poll() is not None and restarts.get(name, 0) < 3:
                    restarts[name] = restarts.get(name, 0) + 1
                    args = proc.args
                    extra = nemo_env(os.path.join(self.d, "nemo-config")) if name == "nemo-desktop" else None
                    self.spawn(name, args, extra)
            try:
                time.sleep(0.5)
            except InterruptedError:
                pass
        for name in list(self.children):
            self.stop_child(name)


def private_env():
    env = dict(os.environ)
    env.update({
        "NOVA_VD_PRIVATE_BUS": "1",
        "XDG_SESSION_TYPE": "x11",
        "XDG_CURRENT_DESKTOP": "Nova",
        "DESKTOP_SESSION": "nova-virtual-display",
        "XDG_SESSION_DESKTOP": "nova-virtual-display",
        "GIO_USE_VFS": "local",
        "GIO_USE_VOLUME_MONITOR": "unix",
        "GTK_USE_PORTAL": "0",
        "NO_AT_BRIDGE": "1",
        "WAYLAND_DISPLAY": "",
    })
    env.pop("DBUS_SESSION_BUS_ADDRESS", None)
    env.pop("SESSION_MANAGER", None)
    env.pop("DESKTOP_STARTUP_ID", None)
    return env


def signal_session(sig):
    try:
        with open(os.path.join(state_dir(), "pid"), encoding="utf-8") as f:
            os.kill(int(f.read().strip()), sig)
        return 0
    except (OSError, ValueError):
        return 1


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "start"
    if cmd == "start":
        if os.environ.get("NOVA_VD_PRIVATE_BUS") != "1" and shutil.which("dbus-run-session"):
            os.execvpe("dbus-run-session", ["dbus-run-session", "--", sys.executable, SELF, "start"], private_env())
        if os.environ.get("NOVA_VD_PRIVATE_BUS") != "1":
            log("dbus-run-session not found; the desktop starts without icons, terminal or file manager isolation")
            os.environ.update(private_env())
        Session(state_dir()).run()
        return 0
    if cmd == "refresh":
        return signal_session(signal.SIGUSR1)
    if cmd == "scale":
        if len(argv) < 3:
            print("usage: nova-vd-session scale PERCENT", file=sys.stderr)
            return 2
        d = state_dir()
        os.makedirs(d, mode=0o700, exist_ok=True)
        pct = clamp_scale(argv[2])
        with open(os.path.join(d, "scale"), "w", encoding="utf-8") as f:
            f.write(str(pct))
        apply_dpi(pct)
        signal_session(signal.SIGHUP)
        return 0
    if cmd == "menu":
        print_library_menu()
        return 0
    if cmd == "run":
        if len(argv) < 3:
            return 2
        env = dict(os.environ)
        env.update(scale_env(read_scale(state_dir())))
        os.execvpe(argv[2], argv[2:], env)
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
